{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git status -s)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git log --oneline -10)",
      "Bash(git log --oneline -20)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git show --stat)",
      "Bash(ls)",
      "Bash(ls -la)",
      "Bash(wc -l)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials*.json)",
      "Read(./**/token*.json)",
      "Read(./**/.clasprc.json)",
      "Read(./**/service-account*.json)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials*.json)",
      "Read(**/client_secret*.json)",
      "Read(**/token*.json)",
      "Read(**/service-account*.json)",
      "Read(**/.clasprc.json)",
      "Read(./.env.*)",
      "Read(./**/.env.*)",
      "Read(./**/*.p12)",
      "Read(./**/client_secret*.json)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *.clasprc.json)",
      "Bash(cat *credentials*)",
      "Bash(cat *client_secret*)",
      "Bash(head .env*)",
      "Bash(head */.env*)",
      "Bash(head *.pem)",
      "Bash(head *.key)",
      "Bash(head *.clasprc.json)",
      "Bash(head *credentials*)",
      "Bash(head *client_secret*)",
      "Bash(tail .env*)",
      "Bash(tail */.env*)",
      "Bash(tail *.pem)",
      "Bash(tail *.key)",
      "Bash(tail *.clasprc.json)",
      "Bash(tail *credentials*)",
      "Bash(tail *client_secret*)",
      "Bash(less .env*)",
      "Bash(less */.env*)",
      "Bash(less *.pem)",
      "Bash(less *.key)",
      "Bash(less *.clasprc.json)",
      "Bash(less *credentials*)",
      "Bash(less *client_secret*)",
      "Bash(more .env*)",
      "Bash(more */.env*)",
      "Bash(more *.pem)",
      "Bash(more *.key)",
      "Bash(more *.clasprc.json)",
      "Bash(more *credentials*)",
      "Bash(more *client_secret*)",
      "Read(./.env.local)",
      "Bash(cat *.pfx)",
      "Bash(sed * .env*)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(declare -p)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(scp *)",
      "Bash(rsync *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-/home/user/TC-drms}\" && [ \"$(git branch --show-current)\" = \"main\" ] && { git diff --quiet && git diff --cached --quiet || (git add -A -- . ':(exclude).github' ':(exclude).claude' ':(exclude)manuscript/knowledge/generated' && git commit -m \"auto-sync $(date -u +%FT%TZ)\" && git push origin main); } || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
