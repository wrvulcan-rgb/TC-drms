{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git status -s)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git log --oneline -10)",
      "Bash(git log --oneline -20)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git show --stat)",
      "Bash(ls)",
      "Bash(ls -la)",
      "Bash(wc -l)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials*.json)",
      "Read(./**/token*.json)",
      "Read(./**/.clasprc.json)",
      "Read(./**/service-account*.json)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-/home/user/TC-drms}\" && [ \"$(git branch --show-current)\" = \"main\" ] && { git diff --quiet && git diff --cached --quiet || (git add -A -- . ':(exclude).github' ':(exclude).claude' ':(exclude)manuscript/knowledge/generated' && git commit -m \"auto-sync $(date -u +%FT%TZ)\" && git push origin main); } || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}